{
    "name": "marketnest-qa",
    "private": true,
    "scripts": {
        "test": "npx playwright test",
        "test:smoke": "npx playwright test --grep \"@smoke|@sanity\" --project=chromium",
        "test:api": "npx playwright test --project=api",
        "seed:main": "npx playwright test --project=seed-main",
        "cleanup:accounts": "npx playwright test --project=cleanup-accounts",
        "accounts:report": "node scripts/accounts-report.js",
        "report": "npx playwright show-report",
        "lint": "npx eslint . --max-warnings 0",
        "postinstall": "is-ci || husky"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.6.6",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "eslint": "^10.14.0",
        "eslint-plugin-playwright": "^2.12.1",
        "eslint-plugin-prettier": "^5.5.7",
        "husky": "^9.1.7",
        "is-ci": "^4.1.0",
        "jiti": "^2.7.0",
        "lint-staged": "^17.6.0"
    },
    "dependencies": {
        "dotenv": "^18.0.9"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "npx eslint --fix --max-warnings 0 --no-warn-ignored",
            "npx prettier --write"
        ]
    },
    "engines": {
        "node": ">=22"
    }
}
