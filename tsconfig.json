{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ESNext", "DOM"],
        "types": ["node"],
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true
    },
    "include": ["**/*.ts", "**/*.mts"],
    "exclude": ["node_modules", "playwright-report", "test-results"]
}
